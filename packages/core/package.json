{
  "name": "@docgit/core",
  "version": "0.1.0",
  "description": "DocGit core engine: document adapters, normalized model, content-addressed snapshot store, diff engine.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model/types.d.ts",
      "default": "./dist/model/types.js"
    },
    "./diff": {
      "types": "./dist/diff/diff.d.ts",
      "default": "./dist/diff/diff.js"
    },
    "./format": {
      "types": "./dist/links/format.d.ts",
      "default": "./dist/links/format.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "docgit": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "diff": "^8.0.4",
    "fast-xml-parser": "^4.5.0",
    "fflate": "^0.8.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  }
}
